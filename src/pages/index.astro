---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { courseMeta, courseShortName } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";

const courseSubtitle = courseMeta.title.split(":")[1]?.trim();
---

<ContentLayout
  title={courseShortName}
  description={courseMeta.description}
  {...siteConfig}
>
  {courseSubtitle && <p class="course-subtitle"><strong>{courseSubtitle}</strong></p>}
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Across twelve weeks, you'll work through one psychological mechanism at a
    time — cliffhangers, autoplay, variable rewards, distorted time
    perception, narrowing recommendation feeds, social cues and more — each
    paired with a short lecture and a hands-on interactive experiment you run
    yourself. By the final week you'll have a working vocabulary for naming
    exactly how a streaming interface keeps a viewer watching, and a chain of
    twelve small demonstrations you can point to as evidence.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone curious about why "just one more episode" so rarely stays true —
    no background in psychology or interface design is assumed. The course
    suits students who want to think critically about the platforms they
    already use, and who are willing to treat their own viewing habits as
    something worth examining rather than taking for granted.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-subtitle {
    margin-block: 0 1rem;
    color: var(--at-text-secondary);
    font-size: 1.1rem;
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>

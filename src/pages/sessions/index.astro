---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import WeeklyScheduleGrid from "../../components/WeeklyScheduleGrid.astro";
import { courseShortName } from "../../course-config";
import { sessionLabels, siteConfig } from "../../site-config";

const description = `The twelve-week teaching schedule: each week's topic and psychological question, with quick links to that week's lecture, slides and interactive experiment.`;
const transitionName = `card-title-${Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-")}`;
---

<BaseLayout
  title={`${sessionLabels.plural} — ${courseShortName}`}
  description={description}
  {...siteConfig}
>
  <h1 transition:name={transitionName}>{sessionLabels.plural} — {courseShortName}</h1>
  <p class="lead">{description}</p>
  <WeeklyScheduleGrid />
</BaseLayout>

<style>
  /* Matches PageLayout.astro: this h1 always introduces the lead paragraph
     directly below it, so it sits close rather than at the theme's generic
     heading distance. */
  h1 {
    margin-block-end: var(--at-spacing-xs);
  }
</style>

---
// The Week 10 interaction: a visible, depleting sleep budget rather than a
// hidden running total. Every episode costs the exact same fixed amount —
// held constant on purpose, so the only variable is how many times the
// visitor spends it — and the remaining budget is shown as a <progress>
// element the whole time, never hidden. The state machine lives in
// src/scripts/sleep-ledger.ts, unit-tested in spec/sleep-ledger.test.ts —
// this component only wires it to the DOM.
---

<div class="sl-experiment" data-sl-root>
  <div class="sl-session" data-sl-session>
    <p>
      You have a fixed amount of sleep time before a fixed wake-up time. Every episode you watch
      costs the same amount off that budget. Watch as many as you like, or stop and bank whatever's
      left.
    </p>
    <p class="sl-remaining" data-sl-remaining></p>
    <progress data-sl-progress max="480" value="480"></progress>
    <div class="sl-actions">
      <button type="button" data-sl-watch>Watch one episode (-42 min)</button>
      <button type="button" data-sl-stop>Stop and go to sleep</button>
    </div>
    <p class="sl-count" data-sl-count></p>
  </div>

  <div class="sl-reveal" data-sl-reveal hidden>
    <h3>What just happened</h3>
    <p data-sl-result></p>
    <p class="sl-disclaimer">
      This is a demonstration with one participant — you — not a controlled study, and the
      thresholds above are this page's own illustrative labels, not a sleep-medicine guideline.
      One session against a made-up budget isn't evidence about your real sleep habits.
    </p>
  </div>
</div>

<script>
  import {
    EPISODE_COST_MINUTES,
    STARTING_BUDGET_MINUTES,
    canAffordAnother,
    createInitialState,
    isComplete,
    stopForSleep,
    summarize,
    watchOne,
    type LedgerState,
  } from "../scripts/sleep-ledger";

  const root = document.querySelector<HTMLElement>("[data-sl-root]");
  if (root) {
    const sessionEl = root.querySelector<HTMLElement>("[data-sl-session]");
    const remainingEl = root.querySelector<HTMLElement>("[data-sl-remaining]");
    const progressEl = root.querySelector<HTMLProgressElement>("[data-sl-progress]");
    const watchButton = root.querySelector<HTMLButtonElement>("[data-sl-watch]");
    const stopButton = root.querySelector<HTMLButtonElement>("[data-sl-stop]");
    const countEl = root.querySelector<HTMLElement>("[data-sl-count]");
    const revealEl = root.querySelector<HTMLElement>("[data-sl-reveal]");
    const resultEl = root.querySelector<HTMLElement>("[data-sl-result]");

    let state: LedgerState = createInitialState();

    function renderSession() {
      if (!remainingEl || !progressEl || !countEl || !watchButton) return;
      const hours = Math.floor(state.remainingMinutes / 60);
      const minutes = state.remainingMinutes % 60;
      remainingEl.textContent = `Sleep budget remaining: ${hours}h ${minutes}m of ${STARTING_BUDGET_MINUTES / 60}h`;
      progressEl.value = state.remainingMinutes;
      countEl.textContent = `Episodes watched so far: ${state.episodesWatched}`;
      watchButton.disabled = !canAffordAnother(state);
      watchButton.textContent = canAffordAnother(state)
        ? `Watch one episode (-${EPISODE_COST_MINUTES} min)`
        : "Not enough budget left for another episode";
    }

    function renderReveal() {
      if (!sessionEl || !revealEl || !resultEl) return;
      sessionEl.hidden = true;
      revealEl.hidden = false;

      const summary = summarize(state);
      const hours = Math.floor(summary.remainingMinutes / 60);
      const minutes = summary.remainingMinutes % 60;
      resultEl.innerHTML = `<strong>${summary.episodesWatched} episodes watched.</strong> ${hours}h ${minutes}m of sleep time left — this session lands in the "${summary.restLevelLabel}" range.`;
    }

    watchButton?.addEventListener("click", () => {
      state = watchOne(state);
      if (isComplete(state)) {
        renderReveal();
      } else {
        renderSession();
      }
    });

    stopButton?.addEventListener("click", () => {
      state = stopForSleep(state);
      renderReveal();
    });

    renderSession();
  }
</script>

<style>
  .sl-experiment {
    border: 1px solid var(--at-color-border, #ccc);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin-block: 1.5rem;
  }

  .sl-remaining {
    font-weight: 600;
    margin-top: 0.75rem;
  }

  progress {
    width: 100%;
    height: 0.75rem;
    margin-top: 0.35rem;
  }

  .sl-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .sl-count {
    font-size: 0.85em;
    opacity: 0.8;
    margin-top: 0.5rem;
  }

  .sl-disclaimer {
    font-size: 0.85em;
    opacity: 0.8;
  }
</style>
